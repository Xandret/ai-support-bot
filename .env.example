# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Нейросеть: gigachat или openai (любой OpenAI-совместимый API, например YandexGPT)
LLM_PROVIDER=gigachat

# GigaChat: «Ключ авторизации» из личного кабинета developers.sber.ru (проект GigaChat API)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модели: GigaChat-2 (базовая, дешевле), GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Lightning…
GIGACHAT_MODEL=GigaChat-2
# Сертификат НУЦ Минцифры (russian_trusted_root_ca.cer), путь к файлу. См. README.
GIGACHAT_CA_BUNDLE=Russian_Trusted_Root_CA.cer
# Только для быстрой проверки, если сертификата пока нет: false отключает проверку TLS
GIGACHAT_VERIFY_SSL=true

# Для LLM_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Куда присылать заявки и вызовы менеджера: ваш chat id (бот покажет его по команде /myid)
MANAGER_CHAT_ID=

# Демо для Kwork: после заявки показывать клиенту, что получил менеджер (для настоящего бизнеса — false)
DEMO_SHOW_MANAGER_VIEW=true

# Название бизнеса и ссылка на кворк (показывается в «Что умеет этот бот»)
BUSINESS_NAME=ТехноДок
KWORK_URL=

# Защита от расхода токенов: сообщений в час на одного пользователя, и сколько пар реплик помнить
RATE_LIMIT_PER_HOUR=30
HISTORY_TURNS=6
